{
  "name": "cube-3dprint-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/server/src/index.ts",
    "dev": "node --env-file-if-exists=.env --watch apps/server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts apps/web/tests/*.test.js",
    "test:browser": "node tests/browser.e2e.mjs",
    "test:setup": "node tests/setup.browser.mjs",
    "test:admin": "node tests/admin.browser.mjs",
    "test:theme": "node tests/theme.browser.mjs",
    "test:i18n": "node tests/i18n.browser.mjs",
    "test:remote-setup": "node tests/remote-setup.browser.mjs",
    "test:reconnect": "node tests/events.browser.mjs",
    "test:cast": "node tests/cast.browser.mjs",
    "preview:readme": "node scripts/readme-preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "marked": "15.0.12",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mqtt": "^5.16.1"
  },
  "license": "SEE LICENSE IN NOTICE.md"
}
